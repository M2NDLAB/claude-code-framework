{
  "env": {
    "AGENT_GIT_BOUNDARY": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(tree:*)"
    ],
    "ask": [
      "Edit(/.claude/settings.json)",
      "Edit(/scripts/agent-git-guard.mjs)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(rm -rf:*)",
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*credentials*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '=== PROJECT MEMORY (STATE.md) ===' && cat .claude/memory/STATE.md 2>/dev/null || echo 'Memory not initialised: see SETUP.md'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); printf '%s' \"$input\" | node \"$CLAUDE_PROJECT_DIR/scripts/agent-git-guard.mjs\" || case \"$input\" in *'\"agent_id\"'*) exit 2;; esac",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
